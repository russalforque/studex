{
  "name": "studex-server",
  "version": "1.0.0",
  "description": "Studex website and licensing backend (Cloudflare Workers + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply studex-licensing --local",
    "db:migrate:remote": "wrangler d1 migrations apply studex-licensing --remote",
    "deploy": "npm run typecheck && npm test && wrangler deploy",
    "keys": "node scripts/generate-keys.mjs",
    "publish-release": "node scripts/publish-release.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "typescript": "~5.9",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "private": true
}
