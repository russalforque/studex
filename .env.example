# Copy to .env.production (release) or .env.development.local (dev). Only VITE_* values reach the
# app, and everything here ends up inside the APK: never put secrets in this file.

# Licensing API used for activation, restore and device moves
VITE_LICENSE_API_URL=https://studex.example/api
VITE_STORE_URL=https://studex.example
VITE_SUPPORT_EMAIL=support@studex.example

# Development only (ignored in production builds): your local server's public key and key id,
# from `npm run keys` in server/.
# VITE_LICENSE_DEV_PUBLIC_KEY=
# VITE_LICENSE_DEV_KID=dev1
# VITE_LICENSE_API_URL=http://localhost:8787/api

# Development only: "1" skips the license screens in `npm run dev`.
# VITE_LICENSE_BYPASS=1
