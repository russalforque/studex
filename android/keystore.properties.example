# Copy to android/keystore.properties (git-ignored) and fill in. Keep the .jks file and these
# passwords in a password manager AND an offline backup: every future Studex update must be
# signed with this same key, or customers can't update without losing their data.
storeFile=C:/Users/you/secure/studex-release.jks
storePassword=
keyAlias=studex
keyPassword=
